<?xml version="1.0"?>
<webforms xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="urn:magento:module:MageMe_WebForms:etc/webforms.xsd">
    <field_types>
        <type id="mailchimp_group_select"
              order="300">
            <label>Mailchimp Group / Select</label>
            <model>MageMe\WebFormsMailchimp\Model\Field\Type\MailchimpGroupSelect</model>
            <category>Mailchimp</category>
            <value>category</value>
            <logic>true</logic>
            <attributes>
                <attribute name="mailchimp_category"/>
                <attribute name="is_multiselect"/>
            </attributes>
        </type>
        <type id="mailchimp_group_select_radio"
              order="310">
            <label>Mailchimp Group / Radio</label>
            <model>MageMe\WebFormsMailchimp\Model\Field\Type\MailchimpGroupSelectRadio</model>
            <category>Mailchimp</category>
            <value>category</value>
            <logic>true</logic>
            <attributes>
                <attribute name="mailchimp_category"/>
                <attribute name="is_internal_elements_inline"/>
            </attributes>
        </type>
        <type id="mailchimp_group_select_checkbox"
              order="320">
            <label>Mailchimp Group / Checkbox</label>
            <model>MageMe\WebFormsMailchimp\Model\Field\Type\MailchimpGroupSelectCheckbox</model>
            <category>Mailchimp</category>
            <value>category</value>
            <logic>true</logic>
            <attributes>
                <attribute name="mailchimp_category"/>
                <attribute name="min_options"/>
                <attribute name="max_options"/>
                <attribute name="min_options_error_text"/>
                <attribute name="max_options_error_text"/>
                <attribute name="is_internal_elements_inline"/>
            </attributes>
        </type>
    </field_types>
</webforms>
